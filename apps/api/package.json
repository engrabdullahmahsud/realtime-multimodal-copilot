{
  "name": "@copilot/api",
  "version": "0.0.0",
  "private": true,
  "description": "Copilot API Server (Hono)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/index.ts src/server.ts --format cjs,esm --dts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "hono": "catalog:",
    "@hono/node-server": "^1.19.0",
    "zod": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "ioredis": "catalog:",
    "dotenv": "catalog:",
    "@copilot/types": "workspace:*"
  },
  "devDependencies": {
    "@copilot/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsup": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "drizzle-kit": "catalog:",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2"
  }
}
