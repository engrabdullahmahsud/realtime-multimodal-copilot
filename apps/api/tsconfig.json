{
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@copilot/types": ["../../packages/types/src/index.ts"],
      "@copilot/types/database": ["../../packages/types/src/database.ts"],
      "@copilot/types/*": ["../../packages/types/src/*"]
    },
    "plugins": [],
    "incremental": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}