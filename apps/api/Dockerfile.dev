# Development Dockerfile for API server
FROM node:20-alpine

WORKDIR /app

# Install dependencies with pnpm
COPY package*.json ./
RUN npm install -g pnpm@11.25.0 && pnpm install --frozen-lockfile

# Copy source code
COPY src ./src
COPY tsconfig.json .
COPY .env.example ./

# Expose port
EXPOSE 3001
ENV NODE_ENV=development
CMD ["pnpm", "run", "dev"]