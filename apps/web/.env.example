# Web Application Environment Variables
# Required variables for the Copilot Web application

# Server
PORT=3000
NODE_ENV=development

# API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Feature flags
NEXT_PUBLIC_ENABLE_VOICE=false
NEXT_PUBLIC_ENABLE_DOCUMENT_UPLOAD=false
NEXT_PUBLIC_ENABLE_AI_COPILOT=false

# Analytics (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_ID=

# Authentication (future - not implemented yet)
# NEXTAUTH_URL=
# NEXTAUTH_SECRET=