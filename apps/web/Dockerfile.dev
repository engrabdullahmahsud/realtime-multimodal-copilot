# Development Dockerfile for Web application (Next.js)
FROM node:20-alpine

WORKDIR /app

# Install dependencies with pnpm
COPY package*.json ./
RUN npm install -g pnpm@11.25.0 && pnpm install --frozen-lockfile

# Copy source code
COPY src ./src
COPY public ./public
COPY tsconfig.json .
COPY next.config.js .
COPY tailwind.config.ts .
COPY .env.example ./

# Expose port
EXPOSE 3000
ENV NODE_ENV=development
CMD ["pnpm", "run", "dev"]