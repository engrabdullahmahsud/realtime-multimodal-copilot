{
  "name": "@copilot/types",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Shared TypeScript types for the Copilot platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./workspace": {
      "import": "./dist/workspace.mjs",
      "require": "./dist/workspace.js",
      "types": "./dist/workspace.d.ts"
    },
    "./document": {
      "import": "./dist/document.mjs",
      "require": "./dist/document.js",
      "types": "./dist/document.d.ts"
    },
    "./conversation": {
      "import": "./dist/conversation.mjs",
      "require": "./dist/conversation.js",
      "types": "./dist/conversation.d.ts"
    },
    "./ai": {
      "import": "./dist/ai.mjs",
      "require": "./dist/ai.js",
      "types": "./dist/ai.d.ts"
    },
    "./database": {
      "import": "./dist/database.mjs",
      "require": "./dist/database.js",
      "types": "./dist/database.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@copilot/config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  }
}
