# ===========================================================
# Environment Variables Template
# Copy this file to .env and fill in values for your setup.
# ===========================================================

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://copilot:copilot123@localhost:5432/copilot

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API Server ────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ── Web Application ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3002

# ── AI Providers (server-side only — never expose to client)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# ── Security ─────────────────────────────────────────────
# POSTGRES_PASSWORD=changeme-in-production
